table DimStage
	lineageTag: b2e705ca-71a7-53c6-876d-71ff6dfdc597

	column common_stage
		dataType: string
		lineageTag: 1501aae5-7ed8-5c64-98b0-9717c92d4356
		summarizeBy: none
		sourceColumn: common_stage
		sortByColumn: stage_order

	column stage_order
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e36e4abd-6b60-5598-addf-5505e565681f
		summarizeBy: none
		sourceColumn: stage_order

	partition DimStage = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "dim_stage.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Selected = Table.SelectColumns(Promoted, {"common_stage", "stage_order"}),
					// empty CSV cells become null before typing (dates of open deals, missing ACV, ...)
					Blanks = Table.TransformColumns(Selected, List.Transform(Table.ColumnNames(Selected), each {_, each if _ = "" then null else _})),
					Typed = Table.TransformColumnTypes(Blanks, {{"common_stage", type text}, {"stage_order", Int64.Type}}, "en-US")
				in
					Typed
