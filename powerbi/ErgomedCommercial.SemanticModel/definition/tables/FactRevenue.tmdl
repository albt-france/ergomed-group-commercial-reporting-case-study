/// SIMULATED. Recognised revenue from finance (approved source for book-to-bill).
table FactRevenue
	lineageTag: 78b8a865-a7fc-5f41-8328-dad95e6a6ca5

	column business
		dataType: string
		lineageTag: c2194e4c-45a8-5936-96bb-ea276d5e1c31
		summarizeBy: none
		sourceColumn: business

	column region
		dataType: string
		lineageTag: f45bd27c-928a-5ccc-b8f9-c4ec52ebd205
		summarizeBy: none
		sourceColumn: region

	column month
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 9c1ef85e-cee9-53d0-b306-8b2b59eb403d
		summarizeBy: none
		sourceColumn: month

		annotation UnderlyingDateTimeDataType = Date

	column revenue_usd
		dataType: double
		formatString: \$#,0
		lineageTag: c004b183-ab95-5c94-adfc-d4dc8d403b35
		summarizeBy: none
		sourceColumn: revenue_usd

	partition FactRevenue = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "fact_revenue.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Selected = Table.SelectColumns(Promoted, {"business", "region", "month", "revenue_usd"}),
					// empty CSV cells become null before typing (dates of open deals, missing ACV, ...)
					Blanks = Table.TransformColumns(Selected, List.Transform(Table.ColumnNames(Selected), each {_, each if _ = "" then null else _})),
					Typed = Table.TransformColumnTypes(Blanks, {{"business", type text}, {"region", type text}, {"month", type date}, {"revenue_usd", type number}}, "en-US")
				in
					Typed
