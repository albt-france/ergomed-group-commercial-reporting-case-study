/// SIMULATED. New-business targets: as received (annual / 12) and re-phased (month-in-quarter profile).
table FactTarget
	lineageTag: a0b81dce-f44c-5b2e-80fc-a056796c8eca

	column business
		dataType: string
		lineageTag: e33f53cd-3542-5eb0-9805-e2b5b55b064c
		summarizeBy: none
		sourceColumn: business

	column region
		dataType: string
		lineageTag: 8faa8dd1-47a6-5964-ac20-6c64378589cc
		summarizeBy: none
		sourceColumn: region

	column month
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: fedb28f4-1005-57f8-8e5c-19592db24224
		summarizeBy: none
		sourceColumn: month

		annotation UnderlyingDateTimeDataType = Date

	column target_flat_usd
		dataType: double
		formatString: \$#,0
		lineageTag: 3c55e1e4-4d5c-59dc-9d41-00cb0ab84d4a
		summarizeBy: none
		sourceColumn: target_flat_usd

	column target_phased_usd
		dataType: double
		formatString: \$#,0
		lineageTag: 0ef1f154-1302-5ca9-9b05-13194300e84d
		summarizeBy: none
		sourceColumn: target_phased_usd

	column fy_target_usd
		dataType: double
		isHidden
		formatString: \$#,0
		lineageTag: 60ff182a-615c-516c-b00c-74c2bc8f9ce7
		summarizeBy: none
		sourceColumn: fy_target_usd

	partition FactTarget = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "fact_target.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Selected = Table.SelectColumns(Promoted, {"business", "region", "month", "target_flat_usd", "target_phased_usd", "fy_target_usd"}),
					// empty CSV cells become null before typing (dates of open deals, missing ACV, ...)
					Blanks = Table.TransformColumns(Selected, List.Transform(Table.ColumnNames(Selected), each {_, each if _ = "" then null else _})),
					Typed = Table.TransformColumnTypes(Blanks, {{"business", type text}, {"region", type text}, {"month", type date}, {"target_flat_usd", type number}, {"target_phased_usd", type number}, {"fy_target_usd", type number}}, "en-US")
				in
					Typed
