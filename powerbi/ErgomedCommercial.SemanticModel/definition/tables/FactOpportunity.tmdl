	partition FactOpportunity = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "fact_opportunity.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Selected = Table.SelectColumns(Promoted, {"opp_key", "business", "source_id", "group_client_id", "client_name", "region", "country", "therapeutic_area", "detail", "services", "source_stage", "common_stage", "status", "currency", "value_local", "fx_rate", "fx_provisional", "value_usd", "cross_sell_adj_usd", "value_usd_governed", "acv_usd", "probability", "weighted_value_usd", "created_date", "proposal_date", "award_date", "won_date", "lost_date", "decision_date", "cancel_date", "reached_proposal", "in_win_rate", "cycle_days", "is_cross_sell", "verbal_award_open", "loss_reason", "data_owner"}),
					// empty CSV cells become null before typing (dates of open deals, missing ACV, ...)
					Blanks = Table.TransformColumns(Selected, List.Transform(Table.ColumnNames(Selected), each {_, each if _ = "" then null else _})),
					Typed = Table.TransformColumnTypes(Blanks, {{"opp_key", Int64.Type}, {"business", type text}, {"source_id", type text}, {"group_client_id", type text}, {"client_name", type text}, {"region", type text}, {"country", type text}, {"therapeutic_area", type text}, {"detail", type text}, {"services", type text}, {"source_stage", type text}, {"common_stage", type text}, {"status", type text}, {"currency", type text}, {"value_local", type number}, {"fx_rate", type number}, {"fx_provisional", type logical}, {"value_usd", type number}, {"cross_sell_adj_usd", type number}, {"value_usd_governed", type number}, {"acv_usd", type number}, {"probability", type number}, {"weighted_value_usd", type number}, {"created_date", type date}, {"proposal_date", type date}, {"award_date", type date}, {"won_date", type date}, {"lost_date", type date}, {"decision_date", type date}, {"cancel_date", type date}, {"reached_proposal", type logical}, {"in_win_rate", type logical}, {"cycle_days", type number}, {"is_cross_sell", type logical}, {"verbal_award_open", type logical}, {"loss_reason", type text}, {"data_owner", type text}}, "en-US")
				in
					Typed
