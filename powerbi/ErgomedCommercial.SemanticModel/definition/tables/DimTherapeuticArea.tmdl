table DimTherapeuticArea
	lineageTag: 3d4e6f77-5679-5a74-bb92-6fac3287bed6

	column therapeutic_area
		dataType: string
		lineageTag: 456bbaee-2814-5955-8040-e6f48bb6f2af
		summarizeBy: none
		sourceColumn: therapeutic_area

	column ta_group
		dataType: string
		lineageTag: 819a1b70-055e-52fc-a9b8-c1dd80340c66
		summarizeBy: none
		sourceColumn: ta_group

	partition DimTherapeuticArea = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "dim_therapeutic_area.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Selected = Table.SelectColumns(Promoted, {"therapeutic_area", "ta_group"}),
					// empty CSV cells become null before typing (dates of open deals, missing ACV, ...)
					Blanks = Table.TransformColumns(Selected, List.Transform(Table.ColumnNames(Selected), each {_, each if _ = "" then null else _})),
					Typed = Table.TransformColumnTypes(Blanks, {{"therapeutic_area", type text}, {"ta_group", type text}}, "en-US")
				in
					Typed
